
# codeforge (local state — do not commit)
.DS_Store
.workflow/
.claude/settings.local.json

# build output
bin/
frontend/dist/
frontend/node_modules/
# Generated from the Go services on every build by the Wails binding generator.
frontend/bindings/

# Vendored third-party SDKs and compiled helpers. Fetched/built by scripts/, never
# committed: the Azure framework is 10 MB of binary, the whisper model 465 MB, and the
# Swift/C++ helpers are machine-specific output of the build scripts.
third_party/speech-sdk/
helpers/bin/
helpers/*.bin

# whisper.cpp checkout, cloned and built by scripts/build-whisper-stt.sh. Gigabytes of
# third-party source and build output, and it carries its own Go bindings that would
# otherwise show up in gofmt and go vet over this module.
scripts/whisper-vendor/
